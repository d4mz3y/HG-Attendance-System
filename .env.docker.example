APP_NAME="Hogan Guards Attendance"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://attendance.hoganguards.internal:8443
APP_TIMEZONE=Africa/Lagos
APP_IMAGE_TAG=release-1
APP_PORT=8443
ZEROTIER_BIND_ADDRESS=10.147.20.10
LAN_BIND_ADDRESS=192.168.10.10
# Leave blank for same-origin only, or list exact browser origins separated by commas.
CORS_ALLOWED_ORIGINS=

TLS_CERT_PATH=/srv/hg-attendance/secrets/tls/server.crt
TLS_KEY_PATH=/srv/hg-attendance/secrets/tls/server.key
TLS_CA_CERT_PATH=/srv/hg-attendance/secrets/tls/ca.crt
TLS_KEY_GROUP_ID=1000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=hg_attendance
DB_USERNAME=hg_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
PORTAL_SESSION_EXPIRATION_MINUTES=480
SANCTUM_REMEMBER_EXPIRATION_DAYS=30

# Mail is required only when scheduled reports are enabled in Settings.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=attendance@hoganguards.com
MAIL_FROM_NAME="Hogan Guards Attendance"
REPORT_SCHEDULE_TIME=06:00

# Paystack keys come from Dashboard > Settings > API Keys & Webhooks.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=USD
PAYSTACK_MONTHLY_AMOUNT=2500
PAYSTACK_YEARLY_AMOUNT=28000
SUBSCRIPTION_TRIAL_START=2026-09-01
SUBSCRIPTION_TRIAL_END=2027-09-01
SUBSCRIPTION_WARNING_DAYS=30
SUBSCRIPTION_DAILY_SCAN_CAP=20
BILLING_EMAIL=

REPORT_MAX_DAYS=366
REPORT_MAX_MATRIX_CELLS=100000
