APP_NAME="Hogan Guards Attendance Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=

# Subscription billing amounts use the currency's smallest unit (USD cents by default).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=USD
PAYSTACK_MONTHLY_AMOUNT=2500
PAYSTACK_YEARLY_AMOUNT=28000
SUBSCRIPTION_TRIAL_START=2026-09-01
SUBSCRIPTION_TRIAL_END=2027-09-01
SUBSCRIPTION_WARNING_DAYS=30
SUBSCRIPTION_DAILY_SCAN_CAP=20
BILLING_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hg_attendance
DB_USERNAME=hg_user
DB_PASSWORD=your_secure_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
PORTAL_SESSION_EXPIRATION_MINUTES=480
SANCTUM_REMEMBER_EXPIRATION_DAYS=30

CACHE_STORE=file
FILESYSTEM_DISK=local

QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=attendance@example.com
MAIL_FROM_NAME="Hogan Guards Attendance Portal"
REPORT_SCHEDULE_TIME=06:00
REPORT_MAX_DAYS=366
REPORT_MAX_MATRIX_CELLS=100000
